	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "bashrc: update",
				"type": "shell",
				"command": "source ~/.bashrc"
			},
			{
				"label": "ALL: UPDATE",
				"type": "shell",
				"command": "devtool api composer update; devtool api php artisan optimize; devtool api php artisan l5-swagger:generate; devtool redis flushdb; devtool api php artisan clear:redis option; devtool api php artisan clear:local-cache; devtool bitrix composer update; devtool bitrix git submodule update; devtool eportal composer update; devtool eportal git submodule update; devtool b2b composer install -v -d /var/www/html/local/php_interface/include/lib/composer/; devtool nova composer update; devtool nova php artisan optimize; "
			},
			// devtool
			{
				"label": "devtool: UP",
				"type": "shell",
				"command": "devtool up"
			},
			{
				"label": "devtool: DOWN",
				"type": "shell",
				"command": "devtool down"
			},
			{
				"label": "devtool: RESTART",
				"type": "shell",
				"command": "devtool down; devtool up"
			},
			// NUXT
			{
				"label": "NUXT: DEV",
				"type": "shell",
				"command": "devtool nuxt npm run dev"
			},
			{
				"label": "NUXT: BUILD",
				"type": "shell",
				"command": "devtool nuxt npm run build"
			},
			{
				"label": "NUXT: START",
				"type": "shell",
				"command": "devtool nuxt npm run start"
			},
			{
				"label": "NUXT: RUN",
				"type": "shell",
				"command": "devtool nuxt npm run build; devtool nuxt npm run start"
			},
			{
				"label": "NUXT: START UPDATE",
				"type": "shell",
				"command": "devtool nuxt npm run build; devtool nuxt npm run start"
			},
			{
				"label": "NUXT: CLEAR BUILD",
				"type": "shell",
				"command": "cd ~/public_html/nuxt/; rm -rf .nuxt"
			},
			{
				"label": "NUXT: LOG",
				"type": "shell",
				"command": "devtool nuxt log"
			},
			{
				"label": "NUXT: DEPLOY STAGING",
				"type": "shell",
				"command": "cd ~/public_html/nuxt/ && git checkout web-02 && git reset --hard main && git push origin HEAD --force"
			},
			{
				"label": "NUXT: UPDATE IMAGE",
				"type": "shell",
				"command": "cd ~/public_html/nuxt/; DOCKER_BUILDKIT=1 docker build --target base -t registry.27zxc.com/root/nuxt:dev --push --no-cache ."
			},
			// NUXT-WEB
			{
				"label": "NUXT-WEB: DEV",
				"type": "shell",
				"command": "cd ~/public_html/nuxt-web/; rm -rf .nuxt .output; devtool nuxt-web npm run dev"
			},
			{
				"label": "NUXT-WEB: BUILD",
				"type": "shell",
				"command": "devtool nuxt npm run build"
			},
			{
				"label": "NUXT-WEB: START",
				"type": "shell",
				"command": "devtool nuxt npm run start"
			},
			{
				"label": "NUXT-WEB: RUN",
				"type": "shell",
				"command": "devtool nuxt-web npm run build; devtool nuxt-web npm run preview"
			},
			{
				"label": "NUXT-WEB: CLEAR BUILD",
				"type": "shell",
				"command": "cd ~/public_html/nuxt-web/; rm -rf .nuxt .output"
			},
			// API
			{
				"label": "API: COMPOSER INSTALL",
				"type": "shell",
				"command": "devtool api composer install -v"
			},
			{
				"label": "API: COMPOSER UPDATE",
				"type": "shell",
				"command": "devtool api composer update"
			},
			{
				"label": "API: ARTISAN OPTIMIZE",
				"type": "shell",
				"command": "devtool api php artisan optimize"
			},
			{
				"label": "API: SWAGGER",
				"type": "shell",
				"command": "devtool api php artisan l5-swagger:generate"
			},
			{
				"label": "API: CLEAR CACHE",
				"type": "shell",
				"command": "devtool redis flushdb; devtool api php artisan clear:redis option; devtool api php artisan clear:local-cache"
			},
			{
				"label": "API: UPDATE ALL",
				"type": "shell",
				"command": "devtool api composer update; devtool api php artisan optimize; devtool api php artisan l5-swagger:generate; devtool redis flushdb; devtool api php artisan clear:redis option; devtool api php artisan clear:local-cache"
			},
			// bitrix
			{
				"label": "BITRIX: COMPOSER INSTALL",
				"type": "shell",
				"command": "devtool bitrix composer install -v"
			},
			{
				"label": "BITRIX: COMPOSER UPDATE",
				"type": "shell",
				"command": "devtool bitrix composer update"
			},
			{
				"label": "BITRIX: SUBMODULE UPDATE",
				"type": "shell",
				"command": "devtool bitrix git submodule update"
			},
			// eportal
			{
				"label": "EPORTAL: COMPOSER INSTALL",
				"type": "shell",
				"command": "devtool eportal composer install -v"
			},
			{
				"label": "EPORTAL: COMPOSER UPDATE",
				"type": "shell",
				"command": "devtool eportal composer update"
			},
			{
				"label": "EPORTAL: SUBMODULE UPDATE",
				"type": "shell",
				"command": "devtool eportal git submodule update"
			},
			// b2b
			{
				"label": "B2B: SUBMODULE UPDATE",
				"type": "shell",
				"command": "devtool b2b git submodule update"
			},
			{
				"label": "B2B: COMPOSER UPDATE",
				"type": "shell",
				"command": "devtool b2b composer install -v -d /var/www/html/local/php_interface/include/lib/composer/"
			},
			// nova
			{
				"label": "NOVA: COMPOSER INSTALL",
				"type": "shell",
				"command": "devtool nova composer install -v"
			},
			{
				"label": "NOVA: COMPOSER UPDATE",
				"type": "shell",
				"command": "devtool nova composer update"
			},
			{
				"label": "NOVA: ARTISAN OPTIMIZE",
				"type": "shell",
				"command": "devtool nova php artisan optimize"
			},
			// widget
			{
				"label": "WIDGET: SUBMODULE UPDATE",
				"type": "shell",
				"command": "cd ~/public_html/nuxt-widget/; git submodule update "
			},
		]
	},
	"settings": {
		"cSpell.words": [
			"nuxt",
			"vueuse"
		]
	}
}
